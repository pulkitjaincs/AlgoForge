{
  "framework": null,
  "installCommand": "pnpm install",
  "buildCommand": "pnpm turbo run build --filter=client...",
  "outputDirectory": "client/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://algoforge-backend-z205.onrender.com/api/$1"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
